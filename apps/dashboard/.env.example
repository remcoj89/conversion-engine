API_BASE_URL=http://127.0.0.1:4000

# Sessies (BFF). Kopieer naar .env en vul echte waarden in; .env wordt nooit gecommit.
APP_ORIGIN=http://localhost:3000
# 32 random bytes, base64. Genereer met: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
SESSION_ENCRYPTION_KEY=
# Voorlopig dezelfde databasegebruiker als de API; een beperkte BFF-rol volgt bij de database-hardening.
SESSION_DATABASE_URL=postgres://conversion_engine:<wachtwoord>@127.0.0.1:5432/conversion_engine
# Alleen voor npm run db:test --workspace dashboard.
SESSION_DATABASE_TEST_URL=postgres://conversion_engine:<wachtwoord>@127.0.0.1:5432/conversion_engine_test

# Zitadel (OIDC) instellingen. Kopieer naar .env en vul echte waarden in; .env wordt nooit gecommit.
AUTH_CLIENT_ID=
AUTH_ISSUER=https://<instance>.zitadel.cloud
AUTH_REDIRECT_URI=http://localhost:3000/auth/callback
AUTHORIZATION_ENDPOINT=https://<instance>.zitadel.cloud/oauth/v2/authorize
TOKEN_ENDPOINT=https://<instance>.zitadel.cloud/oauth/v2/token
JWKS_URI=https://<instance>.zitadel.cloud/oauth/v2/keys
# RP-initiated logout. De post-logout URI moet exact zo in de Zitadel-applicatie geregistreerd staan.
END_SESSION_ENDPOINT=https://<instance>.zitadel.cloud/oidc/v1/end_session
AUTH_POST_LOGOUT_REDIRECT_URI=http://localhost:3000/
