DATABASE_URL=postgresql://ce_api_runtime:change-me@127.0.0.1:5432/conversion_engine
# Verwachte API-database; de API stopt bij een afwijkende database-identiteit.
EXPECTED_API_DATABASE=conversion_engine
# Alleen voor Drizzle-migraties; nooit gebruiken als API-runtimeverbinding.
MIGRATOR_DATABASE_URL=postgresql://ce_migrator:change-me@127.0.0.1:5432/conversion_engine
# Alleen voor lokale provisioning- en onderhoudscommando's.
MAINTENANCE_DATABASE_URL=postgresql://ce_maintenance:change-me@127.0.0.1:5432/conversion_engine
DATABASE_TEST_URL=postgresql://ce_api_runtime:change-me@127.0.0.1:5432/conversion_engine_test
# Optioneel: expliciete migratorverbinding voor tijdelijke DDL in DB-tests.
MIGRATOR_DATABASE_TEST_URL=postgresql://ce_migrator:change-me@127.0.0.1:5432/conversion_engine_test
# Lokale role-bootstrap wachtwoorden. Bewaar deze alleen in apps/api/.env en nooit in Git.
CE_MIGRATOR_PASSWORD=change-me
CE_API_RUNTIME_PASSWORD=change-me
CE_BFF_RUNTIME_PASSWORD=change-me
CE_MAINTENANCE_PASSWORD=change-me
# Issuer van de ZITADEL-instance (altijd https). De JWKS wordt via OIDC-discovery gevonden.
ZITADEL_ISSUER=https://<instance>.zitadel.cloud
# Audience die in het access token moet staan (vast te stellen in de ZITADEL-PoC).
API_AUDIENCE=<audience>
