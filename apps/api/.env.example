DATABASE_URL=postgresql://conversion_engine:change-me@127.0.0.1:5432/conversion_engine
DATABASE_TEST_URL=postgresql://conversion_engine:change-me@127.0.0.1:5432/conversion_engine_test
# Issuer van de ZITADEL-instance (altijd https). De JWKS wordt via OIDC-discovery gevonden.
ZITADEL_ISSUER=https://<instance>.zitadel.cloud
# Audience die in het access token moet staan (vast te stellen in de ZITADEL-PoC).
API_AUDIENCE=<audience>
